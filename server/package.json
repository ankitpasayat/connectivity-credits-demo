{
  "name": "connectivity-credits-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "worker": "node dist/worker.js",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "import:sqlite": "node scripts/import-sqlite.mjs"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "1.10.1",
    "express": "5.1.0",
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
